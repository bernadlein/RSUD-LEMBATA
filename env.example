# Tanpa Supabase, halaman publik dan login dapat dilihat.
# Fitur internal selalu memerlukan akun fasilitas; demo tidak melewati login.
NUXT_PUBLIC_STORAGE_MODE=supabase

# Untuk penggunaan bersama, ubah menjadi supabase dan jalankan migrasi SQL.
# Gunakan anon/publishable key. Jangan gunakan service_role key di frontend.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# ID ruang kerja yang informasinya ditampilkan pada portal publik.
# Untuk admin pertama, isi setelah ruang kerja berhasil dibuat.
# Salin ID melalui Portal & lokasi RS, lalu restart/redeploy aplikasi.
NUXT_PUBLIC_HOSPITAL_ID=

# Hanya dipakai server untuk memvalidasi perubahan sebelum menulis ke database.
# Jangan menambah awalan PUBLIC pada variabel ini.
NUXT_SUPABASE_SERVICE_ROLE_KEY=
